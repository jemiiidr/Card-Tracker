NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only; required for trusted writes to shared card catalog rows.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Server only. Do not add NEXT_PUBLIC_ to this key.
# Required server-only key for TCGDB photo identification.
VISION_API_KEY=your-tcgdb-vision-api-key
# TCG API pricing key (tcg_live_...). POKEMON_TCG_API_KEY is also accepted.
TCGAPI_KEY=your-tcgapi-key
